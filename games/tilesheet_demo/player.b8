func init()
    self.speed = 1
    self:play("idle")
end

func update()
    if btn("RIGHT") then
        self:move(self.speed, 0)
        self:play("walk")
    else
        self:play("idle")
    end

    if btn("LEFT") then
        self:move(-self.speed, 0)
    end

    if btn("DOWN") then
        self:move(0, self.speed)
    end

    if btn("UP") then
        self:move(0, -self.speed)
    end
end

func draw()
    self:spr()
end