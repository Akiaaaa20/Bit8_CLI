x = 28
y = 28

func update()
if btn(LEFT) then
    x = x - 1
end
if btn(RIGHT) then
    x = x + 1
end
if btn(UP) then
    y = y - 1
end
if btn(DOWN) then
    y = y + 1
end
if x < 0 then
    x = 0
end
if x > 56 then
    x = 56
end
if y < 0 then
    y = 0
end
if y > 56 then
    y = 56
end
end

func draw()
cls(0)
spr(0, x, y)
end
